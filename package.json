{
  "name": "the-last-wager",
  "version": "0.0.1",
  "private": true,
  "description": "The Last Wager \u2014 dark-fantasy poker roguelike (P1: playable table)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "build:assets": "node scripts/build-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "simulate": "esbuild scripts/simulate-runs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simulate-runs.mjs --log-level=warning && node node_modules/.cache/simulate-runs.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "phaser": "3.90.0"
  }
}
