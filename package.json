{
  "name": "the-last-wager",
  "version": "0.0.1",
  "private": true,
  "description": "The Last Wager — dark-fantasy poker roguelike (P1: playable table)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "build:assets": "node scripts/build-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "simulate": "esbuild scripts/simulate-runs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/simulate-runs.mjs --log-level=warning && node node_modules/.cache/simulate-runs.mjs",
    "balance": "esbuild scripts/balance-batches.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/balance-batches.mjs --log-level=warning && node node_modules/.cache/balance-batches.mjs",
    "spell-ev": "esbuild scripts/spell-ev.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/spell-ev.mjs --log-level=warning && node node_modules/.cache/spell-ev.mjs",
    "table-ev": "esbuild scripts/table-ev.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/table-ev.mjs --log-level=warning && node node_modules/.cache/table-ev.mjs",
    "paired-policies": "esbuild scripts/paired-policies.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/paired-policies.mjs --log-level=warning && node node_modules/.cache/paired-policies.mjs",
    "aether-ab": "esbuild scripts/aether-ab.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/aether-ab.mjs --log-level=warning && node node_modules/.cache/aether-ab.mjs",
    "rare-branches": "esbuild scripts/rare-branches.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rare-branches.mjs --log-level=warning && node node_modules/.cache/rare-branches.mjs",
    "art": "python3 -I scripts/check-art.py --apply",
    "art:check": "python3 -I scripts/check-art.py",
    "test:art": "python3 -I scripts/test_art_pipeline.py"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "phaser": "3.90.0"
  }
}
