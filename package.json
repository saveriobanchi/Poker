{
  "name": "the-last-wager",
  "version": "0.0.1",
  "private": true,
  "description": "The Last Wager \u2014 dark-fantasy poker roguelike (P1: playable table)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
